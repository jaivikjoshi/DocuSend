# ============================================================
# DocuSend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Required — Supabase project URL (safe to use in server-side Python)
SUPABASE_URL=https://your-project-ref.supabase.co

# Required — Supabase publishable anon key
# This key enforces RLS. It is safe to use in Gradio (server-side Python).
# Do NOT expose this in browser JS unless you fully understand the implications.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — Service role key (bypasses RLS entirely)
# Use ONLY in trusted server-side admin scripts, never in the Gradio app,
# never in frontend code, never in source control.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gemini AI — Used for structured document parsing (Tier 2)
# Get a free key at: https://aistudio.google.com/apikey
# If not set, the app falls back to the legacy regex parser.
GEMINI_API_KEY=your_gemini_api_key_here
